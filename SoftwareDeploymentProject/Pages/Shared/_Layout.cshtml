@inject SoftwareDeploymentProject.Services.ShopStore Store
@inject SoftwareDeploymentProject.Services.CartIdentity Identity
@{ var count = Store.GetCart(Identity.Get()).ItemCount; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Campus essentials. A Swinburne student shopping cart demonstration for SWE40006." />
    <title>@ViewData["Title"] · Campus Store</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="announcement">Fully Automated Deployment Pipeline Website</div>
    <header class="site-header">
        <a class="brand" asp-page="/Index">
<span class="brand-mark" aria-hidden="true">S</span>
<span>SWINBURNE<small>CAMPUS STORE</small>
</span>
</a>
        <nav aria-label="Main navigation">
            <a asp-page="/Index" class="nav-shop">Shop essentials</a>
            <a asp-page="/Cart" class="cart-link">Your cart <span class="cart-count" data-testid="cart-count">@count</span>
</a>
        </nav>
    </header>
    <main id="main" class="container">@RenderBody()</main>
    <footer class="site-footer">
<div>
<strong>Campus Store</strong>
<p>A SWE40006 student project. Unofficial demonstration store.</p>
</div>
<p>Prices in AUD · Simulated checkout · No payments collected<br />
<a asp-page="/Privacy">Privacy &amp; demo information</a>
</p>
</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
